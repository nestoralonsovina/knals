{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/gen/**"],
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": ["build"]
    },
    "generate": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
